# Deneme (staging) ortamı ayarları. /opt/kvkk-staging klasörüne .env adıyla kopyalayıp doldurun.
# Canlının .env dosyasından FARKLI şifreler kullanın (DATA_ENCRYPTION_KEY hariç, aşağıya bakın).

# Deneme ortamının adresi. DNS'te canlı sunucunun IP adresini gösteren bir A kaydı açın.
STAGING_DOMAIN=deneme.ornek.com.tr

# Üretmek için: openssl rand -base64 24
POSTGRES_PASSWORD=
# Üretmek için: openssl rand -base64 48
JWT_SECRET=

# Canlı yedeğini burada geri yükleyip deneyecekseniz canlıdaki değerin aynısı; yoksa yeni üretin
# (openssl rand -base64 32).
DATA_ENCRYPTION_KEY=

# Deneme ortamının yönetim paneline girecek kişiler. Şifre e-postası Mailpit'e düşer.
PLATFORM_ADMIN_EMAILS=

# Canlı yedeklerinin bulunduğu klasör (salt okunur bağlanır).
PROD_BACKUP_DIR=/opt/kvkk/yedekler
