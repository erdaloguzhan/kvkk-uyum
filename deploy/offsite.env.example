# Sunucu dışı yedek ayarları. Sunucuda proje klasörüne offsite.env adıyla kopyalayıp doldurun:
#   cp deploy/offsite.env.example offsite.env && chmod 600 offsite.env
# Bu dosya şifreler içerir: kimseyle paylaşmayın, GitHub'a yüklemeyin.

# Yedeklerin şifrelenmesinde kullanılan parola. Üretmek için: openssl rand -base64 32
# DİKKAT: Kaybolursa sunucu dışındaki yedekler açılamaz. DATA_ENCRYPTION_KEY ile birlikte şifre yöneticisinde saklayın.
OFFSITE_PASSPHRASE=

# Yedeğin kopyalanacağı yer (rclone). Aşağıdaki iki seçenekten birini doldurun; kopyalar Türkiye'de olmalı.

# Seçenek A: başka bir sağlayıcıdaki ikinci bir sunucu (SFTP)
RCLONE_CONFIG_OFFSITE_TYPE=sftp
RCLONE_CONFIG_OFFSITE_HOST=
RCLONE_CONFIG_OFFSITE_USER=yedek
RCLONE_CONFIG_OFFSITE_PORT=22
# SSH şifresi rclone'un gizlenmiş biçiminde: docker run --rm rclone/rclone obscure 'SIFRE'
RCLONE_CONFIG_OFFSITE_PASS=

# Seçenek B: S3 uyumlu nesne depolama (ör. sağlayıcının "nesne depolama" hizmeti)
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.saglayici.com.tr
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# Hedefteki klasör (S3'te kova/klasör), saat (İstanbul, günlük yedekten sonra) ve saklama süresi (gün).
OFFSITE_PATH=kvkk-yedekler
OFFSITE_HOUR=4
OFFSITE_KEEP_DAYS=30

# Her başarılı kopyadan sonra çağrılacak izleme adresi (ör. https://hc-ping.com/...). Kopya gelmezse e-posta alırsınız.
OFFSITE_PING_URL=
