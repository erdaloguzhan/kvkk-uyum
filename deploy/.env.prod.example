# Canlı ortam ayarları. Bu dosyayı sunucuda proje klasörüne .env adıyla kopyalayıp doldurun.
# .env dosyası şifreler içerir: kimseyle paylaşmayın, GitHub'a yüklemeyin.

# Sistemin açılacağı alan adı (DNS A kaydı bu sunucunun IP adresini göstermeli).
DOMAIN=uyum.ornek.com.tr

# Veritabanı şifresi. Üretmek için: openssl rand -hex 24  (base64 kullanmayın: / + = karakterleri bağlantı adresini bozar)
POSTGRES_PASSWORD=

# Oturum anahtarı (en az 32 karakter). Üretmek için: openssl rand -hex 48
JWT_SECRET=

# T.C. kimlik no şifreleme anahtarı. Üretmek için: openssl rand -base64 32
# DİKKAT: Kaybolursa şifreli kimlik numaraları okunamaz. Yedeklerden ayrı, güvenli bir yerde saklayın
# ve kurulumdan sonra değiştirmeyin.
DATA_ENCRYPTION_KEY=

# E-posta gönderimi (giriş kodları, şifre bağlantıları, hatırlatmalar).
# Ör. smtp://kullanici:sifre@smtp.saglayici.com:587  (465 portu için smtps://)
# Kullanıcı adındaki @ işareti %40 yazılır: smtp://info%40ornek.com.tr:sifre@mail.ornek.com.tr:587
SMTP_URL=
MAIL_FROM=KVK Yönetim Sistemi <no-reply@ornek.com.tr>

# Yönetim paneline girecek kişiler (virgülle ayrılmış). Hesabı yoksa açılır ve şifre bağlantısı gönderilir.
PLATFORM_ADMIN_EMAILS=

# Yeni kuruluşların deneme süresi (gün).
TRIAL_DAYS=30

# Günlük yedeğin alınacağı saat (İstanbul) ve kaç gün saklanacağı.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
