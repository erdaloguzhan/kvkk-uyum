DATABASE_URL=postgres://kvkk:kvkk@localhost:5432/kvkk
JWT_SECRET=degistir-en-az-32-karakter-rastgele-bir-deger
PORT=3000
# Cloudflare Turnstile gizli anahtarı. Boş bırakılırsa CAPTCHA kontrolü kapalıdır (yalnızca geliştirme).
CAPTCHA_SECRET=
# Yeni kuruluşların deneme süresi (gün)
TRIAL_DAYS=30
# Doküman şablonlarının klasörü. Boş bırakılırsa depodaki content/ kullanılır.
CONTENT_DIR=
# Görev hatırlatma ve gecikme alarmlarının kaç dakikada bir taranacağı (0: kapalı)
ALARM_INTERVAL_MINUTES=60
# E-posta sunucusu (ör. smtp://kullanici:sifre@smtp.ornek.com:587). Boş bırakılırsa e-postalar gönderilmez, API loguna yazılır.
SMTP_URL=
MAIL_FROM=KVK Yönetim Sistemi <no-reply@ornek.com>
# Web arayüzü API'ye sunucu tarafından bağlandığı için CORS gerekmez; başka bir istemci için virgülle ayrılmış adresler.
CORS_ORIGINS=
